@page "/audit"
@model WebDbViewer.Web.Pages.Audit.AuditIndexModel
@{
    ViewData["Title"] = "Журнал аудита";
}
<div class="page">
    <h1>Журнал аудита запросов</h1>

    <form id="audit-filter"
          hx-get="/audit?handler=Query"
          hx-target="#audit-results"
          hx-swap="innerHTML"
          hx-trigger="submit, load"
          class="data-toolbar data-toolbar--card">
        <div class="field">
            <label for="audit-from">С даты</label>
            <input type="date" id="audit-from" name="from" value="@Model.DefaultFrom" />
        </div>
        <div class="field">
            <label for="audit-to">По дату</label>
            <input type="date" id="audit-to" name="to" value="@Model.DefaultTo" />
        </div>
        <div class="field">
            <label for="audit-user">Пользователь</label>
            <input type="text" id="audit-user" name="userName" placeholder="все пользователи" />
        </div>
        <div class="field">
            <label for="audit-ds">Датасорс</label>
            <select id="audit-ds" name="dataSourceId">
                <option value="">— все —</option>
                @foreach (var ds in Model.DataSources)
                {
                    <option value="@ds.Id">@ds.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary btn-icon"
                aria-label="Показать записи"
                data-tip="Показать записи журнала за выбранный период">@UiIcons.Filter</button>
        @* Подпись индикатора видна только скринридеру: рядом с иконочной кнопкой
           текстовая метка ломает ряд (см. DESIGN.md, «только иконка»). *@
        <span class="htmx-indicator" role="status">
            <span class="spinner" aria-hidden="true"></span>
            <span class="visually-hidden">Загрузка…</span>
        </span>
    </form>

    <div id="audit-results">
        <div class="alert alert-info">Задайте фильтры и нажмите «Показать».</div>
    </div>
</div>
