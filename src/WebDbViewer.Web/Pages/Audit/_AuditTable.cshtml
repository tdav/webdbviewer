@model IReadOnlyList<WebDbViewer.Core.AuditEntry>
@if (Model.Count == 0)
{
    <div class="alert alert-info">Записей за выбранный период не найдено.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Время</th>
                <th>Пользователь</th>
                <th>SQL</th>
                <th>Длительность</th>
                <th>Строк</th>
                <th>Статус</th>
                <th>IP</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model)
            {
                <tr>
                    <td style="white-space:nowrap">@entry.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td>@entry.UserName</td>
                    <td>
                        <code style="font-family:var(--mono);font-size:12px" title="@entry.SqlText">
                            @(entry.SqlText.Length > 120 ? entry.SqlText[..120] + "…" : entry.SqlText)
                        </code>
                    </td>
                    <td>@entry.Duration.TotalMilliseconds.ToString("F0") мс</td>
                    <td>@(entry.RowsAffected?.ToString() ?? "—")</td>
                    <td>
                        @if (entry.Success)
                        {
                            <span class="badge badge-ssl">OK</span>
                        }
                        else
                        {
                            <span class="badge badge-prod" title="@entry.ErrorMessage">Ошибка</span>
                        }
                    </td>
                    <td>@(entry.ClientIp ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}
