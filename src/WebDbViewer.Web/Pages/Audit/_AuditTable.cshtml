@model IReadOnlyList<WebDbViewer.Core.AuditEntry>
@if (Model.Count == 0)
{
    <div class="alert alert-info">Записей за выбранный период не найдено.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Время</th>
                <th>Пользователь</th>
                <th>SQL</th>
                <th class="col-num">Длительность</th>
                <th class="col-num">Строк</th>
                <th>Статус</th>
                <th>IP</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model)
            {
                @* Всё, что читается посимвольно — время, SQL, длительность, счётчик, IP —
                   идёт моноширинным: соседние строки должны сравниваться взглядом. *@
                <tr>
                    <td class="cell-mono col-nowrap">@entry.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td>@entry.UserName</td>
                    <td class="cell-sql">
                        <code title="@entry.SqlText">@(entry.SqlText.Length > 120 ? entry.SqlText[..120] + "…" : entry.SqlText)</code>
                    </td>
                    <td class="cell-mono col-num">@entry.Duration.TotalMilliseconds.ToString("F0") мс</td>
                    <td class="cell-mono col-num">@(entry.RowsAffected?.ToString() ?? "—")</td>
                    <td>
                        @if (entry.Success)
                        {
                            <span class="badge badge-ok">OK</span>
                        }
                        else
                        {
                            <span class="badge badge-error" title="@entry.ErrorMessage">Ошибка</span>
                        }
                    </td>
                    <td class="cell-mono cell-muted">@(entry.ClientIp ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}
