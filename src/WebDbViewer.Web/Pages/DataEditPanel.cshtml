@*
    Партиал панели inline-редактирования данных таблицы.
    Подключение (интеграционный агент, Data.cshtml, рядом с тулбаром над гридом):
        <partial name="DataEditPanel" model="Model.IsReadOnly" />
    Модель — bool: датасорс только для чтения (панель скрыта и не активируется).
    Кнопки обслуживает grid.js: он находит [data-edit-panel] в ближайшем общем контейнере грида;
    если партиал не подключён — grid.js создаёт такую же панель сам (fallback).
    Также в контейнер грида нужно добавить атрибут data-readonly="true|false".
*@
@model bool

<div class="data-edit-panel" data-edit-panel data-readonly="@(Model ? "true" : "false")" hidden>
    @* Счётчик изменений остаётся видимым: это не подпись кнопки, а число,
       которое пользователь обязан видеть до отправки в базу. *@
    <button type="button" class="btn btn-primary btn-icon btn-icon-count" data-edit-action="save"
            aria-label="Сохранить изменения"
            data-tip="Отправить накопленные изменения в базу данных">
        @UiIcons.Save<span class="btn-count" data-edit-count>0</span>
    </button>
    <button type="button" class="btn btn-icon" data-edit-action="discard"
            aria-label="Отменить изменения"
            data-tip="Отбросить все несохранённые правки">@UiIcons.Rollback</button>
    <span style="width:12px"></span>
    <button type="button" class="btn btn-icon" data-edit-action="add-row"
            aria-label="Добавить строку"
            data-tip="Добавить пустую строку в конец таблицы">@UiIcons.RowAdd</button>
    <button type="button" class="btn btn-icon" data-edit-action="delete-rows"
            aria-label="Удалить выделенные строки"
            data-tip="Пометить выделенные строки на удаление">@UiIcons.RowDelete</button>
</div>
