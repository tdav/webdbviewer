@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@{
    var tokens = Xsrf.GetAndStoreTokens(Context);
    var userName = Context.User.Identity?.IsAuthenticated == true ? Context.User.Identity!.Name : null;

    // aria-current="page" — и подсветка активного раздела, и подсказка скринридеру.
    string? NavCurrent(string segment) =>
        Context.Request.Path.StartsWithSegments(segment) ? "page" : null;
}
<!DOCTYPE html>
<html lang="ru" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? t + " — WebDbViewer" : "WebDbViewer")</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    @* asp-append-version — хэш файла в query: браузер не отдаёт устаревший CSS/JS из кэша *@
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true" />
    <script>
        // Применяем сохранённую тему до отрисовки, чтобы не мигало
        (function () {
            try {
                var theme = localStorage.getItem("wdv-theme");
                if (theme) document.documentElement.setAttribute("data-theme", theme);
            } catch (e) { /* localStorage недоступен — остаёмся на теме по умолчанию */ }
        })();
    </script>
</head>
<body hx-headers='{"RequestVerificationToken": "@tokens.RequestToken"}'>
    <header class="topbar">
        <div class="topbar-brand">
            <span class="brand-icon">@UiIcons.Brand</span>
            <span class="brand-name">WebDbViewer</span>
        </div>
        <nav class="topbar-nav" aria-label="Разделы">
            <a href="/editor" class="nav-link" aria-current="@NavCurrent("/editor")">SQL-редактор</a>
            <a href="/connections" class="nav-link" aria-current="@NavCurrent("/connections")">Подключения</a>
            <a href="/audit" class="nav-link" aria-current="@NavCurrent("/audit")">Аудит</a>
        </nav>
        <div class="topbar-actions">
            @* data-theme-toggle — делегированный обработчик в app.js, единственный владелец темы. *@
            <button type="button" class="btn btn-ghost btn-icon" data-theme-toggle
                    aria-label="Переключить тему"
                    data-tip="Переключить светлую и тёмную тему">@UiIcons.Theme</button>
            @if (userName is not null)
            {
                @* Имя пользователя — не кнопка: это подпись текущей сессии, и её
                   нельзя свести к иконке, не потеряв само значение. *@
                <span class="user-name" data-tip="Текущий пользователь">
                    @UiIcons.User
                    @userName
                </span>
                <form method="post" action="/login?handler=Logout" class="inline-form">
                    <input type="hidden" name="__RequestVerificationToken" value="@tokens.RequestToken" />
                    <button type="submit" class="btn btn-ghost btn-icon"
                            aria-label="Выйти"
                            data-tip="Завершить сеанс и вернуться к форме входа">@UiIcons.Logout</button>
                </form>
            }
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <div id="toast-area" aria-live="polite"></div>

    <script src="/js/htmx.min.js" asp-append-version="true"></script>
    <script src="/js/app.js" asp-append-version="true"></script>
    <script src="/js/splitter.js" asp-append-version="true"></script>
    <script src="/js/editor.js" asp-append-version="true"></script>
    <script src="/js/grid.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
