@using WebDbViewer.Web.Pages.Shared
@model TreeNodeVm
@{
    var node = Model.Node;
    var expandable = node.HasChildren && !Model.NoExpand;
    var url = $"/tree?ds={Model.DsId}&path={Uri.EscapeDataString(Model.Path)}";
    // Ссылка на просмотр данных для таблиц/представлений; db — если объект в другой базе сервера
    var isDataObject = node.Type is DbObjectType.Table or DbObjectType.View or DbObjectType.MaterializedView;
    var dbQuery = Model.Database is { Length: > 0 } db ? $"?db={Uri.EscapeDataString(db)}" : "";
    var dataUrl = isDataObject && node.Schema is not null
        ? $"/data/{Model.DsId}/{Uri.EscapeDataString(node.Schema)}/{Uri.EscapeDataString(node.Name)}{dbQuery}"
        : null;

    // Обычный клик открывает данные вкладкой рядом с редактором; href остаётся ради
    // Ctrl+клика и средней кнопки — они уводят на отдельную страницу, как раньше.
    var dataTabUrl = dataUrl is null ? null : string.Concat(
        "/editor?handler=DataTab",
        "&ds=", Model.DsId.ToString(),
        "&schema=", Uri.EscapeDataString(node.Schema!),
        "&table=", Uri.EscapeDataString(node.Name),
        Model.Database is { Length: > 0 } dataDb ? "&db=" + Uri.EscapeDataString(dataDb) : "");

    // Атрибуты узла: у папок-категорий — русское название и счётчик, у объектов — уточнение
    // (сигнатура перегрузки, таблица-владелец триггера и т.п.).
    var attrs = node.Attributes;
    string? Attr(string key) => attrs is not null && attrs.TryGetValue(key, out var v) && v.Length > 0 ? v : null;
    var isFolder = Attr("kind") == "folder";
    var isRoutine = node.Type is DbObjectType.Function or DbObjectType.Procedure or DbObjectType.Aggregate;
    var label = isFolder ? Attr("title") ?? node.Name : node.Name;
    var suffix = isFolder ? Attr("count")
        : isRoutine ? "(" + (attrs is not null && attrs.TryGetValue("signature", out var s) ? s : "") + ")"
        : Attr("table") ?? Attr("baseType") ?? Attr("typeKind") ?? Attr("provider");
    var tipTitle = isFolder ? label : DbObjectIcons.Title(node.Type, Model.Kind);

    // Кнопка «показать DDL»: только у настоящих объектов схемы (не у папок-категорий,
    // схем, баз и колонок) и только для типов, DDL которых умеет строить генератор.
    var ddlType = isFolder || node.Schema is null ? null : DdlObjectTypes.ForApi(node.Type);

    // qualifier отличает объект от одноимённых: таблица-владелец у триггера/правила/политики,
    // сигнатура аргументов у перегруженной функции.
    var qualifier = Attr("table") ?? (isRoutine && attrs is not null && attrs.TryGetValue("signature", out var qs) && qs.Length > 0 ? qs : null);
    var scriptUrlBase = ddlType is null ? null : string.Concat(
        "/editor?handler=DdlTab",
        "&ds=", Model.DsId.ToString(),
        "&schema=", Uri.EscapeDataString(node.Schema!),
        "&name=", Uri.EscapeDataString(node.Name),
        "&type=", ddlType,
        qualifier is not null ? "&qualifier=" + Uri.EscapeDataString(qualifier) : "",
        Model.Database is { Length: > 0 } ddlDb ? "&db=" + Uri.EscapeDataString(ddlDb) : "");

    var ddlUrl = scriptUrlBase;
    // Скрипт DROP не предлагается для датасорса «только чтение»: выполнить его там всё равно нельзя.
    var dropUrl = scriptUrlBase is null || Model.ReadOnly ? null : scriptUrlBase + "&script=drop";

    // Экспорт в SQL — там же, где есть данные. Обычный клик открывает скрипт вкладкой
    // (с пределом строк), Ctrl+клик уводит на endpoint и скачивает таблицу целиком:
    // тот же приём, что и у ссылки на данные ниже.
    // Только таблицы: у представления «структура + данные» означало бы CREATE VIEW и
    // выгрузку производных строк — для этого есть экспорт результата запроса.
    var exportQuery = node.Type is not DbObjectType.Table || node.Schema is null ? null : string.Concat(
        "ds=", Model.DsId.ToString(),
        "&schema=", Uri.EscapeDataString(node.Schema),
        "&name=", Uri.EscapeDataString(node.Name),
        Model.Database is { Length: > 0 } exportDb ? "&db=" + Uri.EscapeDataString(exportDb) : "");
    var exportTabUrl = exportQuery is null ? null : "/editor?handler=ExportTab&" + exportQuery;
    var exportFileUrl = exportQuery is null ? null : "/api/export/sql?" + exportQuery.Replace("&name=", "&table=");
}
@* Кнопка DDL одинакова в обеих ветках разметки — вынесена в локальную функцию. *@
@{
    void RenderActions()
    {
        if (ddlUrl is null && dataUrl is null && exportTabUrl is null)
            return;
        <span class="tree-actions">
            @if (dropUrl is not null)
            {
                <button type="button" class="tree-open-data tree-action-danger"
                        hx-get="@dropUrl"
                        @* Номер вкладки даёт wdvNextTabIndex (см. Editor/Index.cshtml): считать
                           по количеству вкладок нельзя — после закрытия номера переиспользуются
                           и id панелей начинают дублироваться. *@
                        hx-vals='js:{index: window.wdvNextTabIndex ? window.wdvNextTabIndex() : 1}'
                        hx-target="#editor-panes"
                        hx-swap="beforeend"
                        aria-label="Скрипт удаления: @node.Name"
                        data-tip="Открыть скрипт DROP «@node.Name» во вкладке редактора (не выполняется)"
                        onclick="event.stopPropagation()">@UiIcons.Trash</button>
            }
            @if (ddlUrl is not null)
            {
                <button type="button" class="tree-open-data"
                        hx-get="@ddlUrl"
                        @* Номер вкладки даёт wdvNextTabIndex (см. Editor/Index.cshtml): считать
                           по количеству вкладок нельзя — после закрытия номера переиспользуются
                           и id панелей начинают дублироваться. *@
                        hx-vals='js:{index: window.wdvNextTabIndex ? window.wdvNextTabIndex() : 1}'
                        hx-target="#editor-panes"
                        hx-swap="beforeend"
                        aria-label="Показать DDL: @node.Name"
                        data-tip="Открыть DDL «@node.Name» во вкладке редактора"
                        onclick="event.stopPropagation()">@UiIcons.Ddl</button>
            }
            @if (exportTabUrl is not null)
            {
                <a class="tree-open-data" href="@exportFileUrl" download
                   hx-get="@exportTabUrl"
                   @* Ctrl/Cmd/Shift+клик оставляем браузеру: он скачает файл по href,
                      минуя предел строк, который стоит на вкладке редактора. *@
                   hx-trigger="click[!ctrlKey&amp;&amp;!metaKey&amp;&amp;!shiftKey]"
                   hx-vals='js:{index: window.wdvNextTabIndex ? window.wdvNextTabIndex() : 1}'
                   hx-target="#editor-panes"
                   hx-swap="beforeend"
                   aria-label="Экспорт в SQL: @node.Name"
                   data-tip="Открыть SQL-скрипт «@node.Name» во вкладке (Ctrl+клик — скачать файл целиком)"
                   onclick="event.stopPropagation()">@UiIcons.Export</a>
            }
            @if (dataUrl is not null)
            {
                <a class="tree-open-data" href="@dataUrl"
                   hx-get="@dataTabUrl"
                   @* Ctrl/Cmd/Shift+клик оставляем браузеру: это привычный способ
                      открыть ссылку отдельной вкладкой или окном. *@
                   hx-trigger="click[!ctrlKey&amp;&amp;!metaKey&amp;&amp;!shiftKey]"
                   hx-vals='js:{index: window.wdvNextTabIndex ? window.wdvNextTabIndex() : 1}'
                   hx-target="#editor-panes"
                   hx-swap="beforeend"
                   aria-label="Открыть данные: @node.Name"
                   data-tip="Открыть данные таблицы «@node.Name» во вкладке (Ctrl+клик — отдельной страницей)"
                   onclick="event.stopPropagation()">@UiIcons.OpenData</a>
            }
        </span>
    }
}
<li class="tree-node @(node.IsSystem ? "system" : null)" data-type="@node.Type" data-name="@node.Name" data-schema="@node.Schema" data-database="@Model.Database">
    @if (expandable)
    {
        @* Раскрытием управляет делегированный обработчик в app.js: он же держит
           aria-expanded и класс .expanded в согласии с реальным состоянием. *@
        <span class="tree-label"
              role="button"
              tabindex="0"
              aria-expanded="false"
              hx-get="@url"
              hx-trigger="click once, keydown[key=='Enter'||key==' '] once"
              hx-target="closest li"
              hx-swap="beforeend"
              hx-include="#nav-hide-system"
              title="@tipTitle@(node.Comment is not null ? " — " + node.Comment : "")">
            <span class="tree-toggle">&#9656;</span><span class="tree-icon">@DbObjectIcons.For(node.Type, Model.Kind)</span>
            <span class="tree-name">@label</span>
            @if (suffix is not null)
            {
                <span class="tree-comment">@suffix</span>
            }
            @{ RenderActions(); }
        </span>
    }
    else
    {
        <span class="tree-label" title="@tipTitle@(node.Comment is not null ? " — " + node.Comment : "")">
            <span class="tree-toggle"></span><span class="tree-icon">@DbObjectIcons.For(node.Type, Model.Kind)</span>
            @if (dataUrl is not null)
            {
                <a href="@dataUrl" class="tree-name" title="Открыть данные во вкладке (Ctrl+клик — отдельной страницей)"
                   hx-get="@dataTabUrl"
                   hx-trigger="click[!ctrlKey&amp;&amp;!metaKey&amp;&amp;!shiftKey]"
                   hx-vals='js:{index: window.wdvNextTabIndex ? window.wdvNextTabIndex() : 1}'
                   hx-target="#editor-panes"
                   hx-swap="beforeend">@label</a>
            }
            else
            {
                <span class="tree-name">@label</span>
            }
            @if (node.Schema is not null && Model.NoExpand)
            {
                <span class="tree-comment">@node.Schema</span>
            }
            else if (suffix is not null)
            {
                <span class="tree-comment">@suffix</span>
            }
            @{ RenderActions(); }
        </span>
    }
</li>
