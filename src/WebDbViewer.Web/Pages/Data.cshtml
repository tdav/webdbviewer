@page "/data/{ds:guid}/{schema}/{table}"
@model WebDbViewer.Web.Pages.DataModel
@{
    ViewData["Title"] = $"{Model.Schema}.{Model.Table}";
}
<div class="main-content" style="display:flex;flex-direction:column;min-height:0">
    <div class="data-toolbar">
        <div style="display:flex;align-items:center;gap:8px;margin-right:auto">
            <strong title="Датасорс">@Model.DataSourceName</strong>
            @if (Model.IsProduction)
            {
                <span class="badge badge-prod" title="Производственная база!">PROD</span>
            }
            @if (Model.IsReadOnly)
            {
                <span class="badge badge-ro">RO</span>
            }
            @if (Model.IsOtherDatabase)
            {
                <span class="badge badge-scope" title="Объект в другой базе данных сервера">@Model.Database</span>
            }
            <span class="tree-comment" style="font-size:13px">@Model.Schema.@Model.Table</span>
        </div>

        <div class="field">
            <label for="data-where">Фильтр (WHERE)</label>
            <input type="text" id="data-where" data-role="where-filter" style="width:480px"
                   placeholder="например: id &gt; 100 AND name LIKE 'А%'" />
        </div>
        <div class="field">
            <label for="data-orderby">Сортировка (ORDER BY)</label>
            <input type="text" id="data-orderby" data-role="order-by" style="width:170px" placeholder="колонка" />
        </div>
        <div class="field">
            <label for="data-orderdir">Направление</label>
            <select id="data-orderdir" data-role="order-dir">
                <option value="asc">По возрастанию</option>
                <option value="desc">По убыванию</option>
            </select>
        </div>
        <div class="field">
            <label for="data-limit">Строк на страницу</label>
            <select id="data-limit" data-role="page-limit">
                <option>100</option>
                <option selected>200</option>
                <option>500</option>
                <option>1000</option>
            </select>
        </div>
        <button type="button" id="data-apply" class="btn btn-primary btn-icon" data-action="apply-filter"
                aria-label="Применить фильтр"
                data-tip="Перечитать таблицу с заданным условием и сортировкой">@UiIcons.Filter</button>
        <button type="button" id="data-refresh" class="btn btn-icon" data-action="refresh"
                aria-label="Обновить данные"
                data-tip="Перечитать таблицу, сохранив текущий фильтр">@UiIcons.Refresh</button>
    </div>

    @* Контейнер виртуализованного грида: заполняется grid.js по data-атрибутам *@
    <div class="grid-container"
         id="data-grid"
         data-result-grid
         data-mode="table"
         data-ds-id="@Model.DsId"
         data-schema="@Model.Schema"
         data-table="@Model.Table"
         data-database="@(Model.IsOtherDatabase ? Model.Database : null)"
         data-readonly="@(Model.IsReadOnly ? "true" : "false")">
        @* Скелет таблицы держит место до того, как grid.js поднимется и очистит
           контейнер (buildDom): страница не «прыгает» от пустоты к сетке. *@
        <div class="results-placeholder results-placeholder--loading" role="status">
            <span class="visually-hidden">Загрузка данных таблицы…</span>
            <div class="skeleton-table" aria-hidden="true">
                <div class="skeleton-row skeleton-row--head">
                    <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
                </div>
                <div class="skeleton-row">
                    <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
                </div>
                <div class="skeleton-row">
                    <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
                </div>
                <div class="skeleton-row">
                    <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
                </div>
                <div class="skeleton-row">
                    <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
                </div>
                <div class="skeleton-row">
                    <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
                </div>
                <div class="skeleton-row">
                    <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="results-status" id="data-status" data-role="grid-status">Готово</div>
</div>
