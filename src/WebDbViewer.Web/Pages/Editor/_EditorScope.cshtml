@model WebDbViewer.Web.Pages.Editor.EditorScopeVm
@*
    Область выполнения запроса: база данных (если СУБД их различает и подключению разрешены все базы)
    и схема. Перерисовывается целиком при смене датасорса или базы.
*@
@if (Model.Databases.Count > 0)
{
    <label for="editor-database" style="margin:0">База</label>
    @* hx-sync: тот же ключ, что у #editor-ds — без него быстрая смена базы вслед за
       датасорсом не отменяет более ранний запрос, и его поздний ответ может затереть
       тулбар устаревшим фрагментом. *@
    <select id="editor-database" name="db" data-role="database-select"
            hx-get="/editor?handler=Scope"
            hx-trigger="change"
            hx-include="#editor-ds, #editor-database"
            hx-target="#editor-scope"
            hx-swap="innerHTML"
            hx-sync="#editor-scope:replace">
        @foreach (var db in Model.Databases)
        {
            <option value="@db" selected="@(db == Model.SelectedDatabase)">@db</option>
        }
    </select>
}

<label for="editor-schema" style="margin:0">Схема</label>
<select id="editor-schema" name="schema" data-role="schema-select">
    <option value="">— по умолчанию —</option>
    @foreach (var schema in Model.Schemas)
    {
        <option value="@schema">@schema</option>
    }
</select>
<button type="button" class="btn btn-icon" data-action="refresh-metadata"
        aria-label="Обновить метаданные схемы"
        data-tip="Перечитать список таблиц и колонок схемы — после изменения структуры БД">@UiIcons.Refresh</button>
@if (Model.ErrorMessage is not null)
{
    <span class="cell-muted" title="@Model.ErrorMessage">— список недоступен —</span>
}
