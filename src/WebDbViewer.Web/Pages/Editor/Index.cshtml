@page "/editor"
@using WebDbViewer.Web.Pages.Shared
@model WebDbViewer.Web.Pages.Editor.EditorIndexModel
@{
    ViewData["Title"] = "SQL-редактор";
    var defaultDs = Model.DataSources.FirstOrDefault();
}

<div class="workbench">
    @* ===================== Левая панель: навигатор БД ===================== *@
    <aside class="navigator" id="db-navigator">
        <div class="navigator-toolbar">
            <select id="nav-search-ds" name="ds" title="Датасорс для поиска">
                @if (Model.DataSources.Count == 0)
                {
                    <option value="">— нет подключений —</option>
                }
                @foreach (var ds in Model.DataSources)
                {
                    <option value="@ds.Id">@ds.Name</option>
                }
            </select>
            <input type="text" name="q" id="nav-search" placeholder="Поиск объектов…"
                   hx-get="/tree?handler=Search"
                   hx-trigger="input changed delay:400ms, search"
                   hx-target="#nav-search-results"
                   hx-swap="innerHTML"
                   hx-include="#nav-search-ds" />
            <label class="checkbox-field" title="Не показывать системные схемы и объекты">
                <input type="checkbox" id="nav-hide-system" name="hideSystem" value="true" checked />
                Скрывать системные объекты
            </label>
        </div>
        <div class="navigator-body">
            <div id="nav-search-results"></div>
            @if (Model.DataSources.Count == 0)
            {
                <div class="tree-empty">
                    Нет подключений. <a href="/connections">Создать подключение</a>
                </div>
            }
            else
            {
                <ul class="tree" id="nav-tree-root">
                    @foreach (var ds in Model.DataSources)
                    {
                        <partial name="_TreeNode" model="@(new TreeNodeVm
                            {
                                DsId = ds.Id,
                                Path = "",
                                ReadOnly = ds.ReadOnly,
                                Kind = ds.Kind,
                                Node = new DbObjectNode
                                {
                                    Name = ds.Name,
                                    Type = DbObjectType.Database,
                                    HasChildren = true,
                                    Comment = ds.IsProduction ? "PRODUCTION" : null
                                }
                            })" />
                    }
                </ul>
            }
        </div>
    </aside>

    <div class="splitter-v" id="splitter-v" tabindex="0"
         aria-label="Изменить ширину навигатора (перетащите или используйте стрелки; двойной клик — сброс)"></div>

    @* ===================== Центр: вкладки редактора + низ: результаты ===================== *@
    <div class="editor-and-results">
        <section class="editor-panel">
            <div class="editor-tabs-bar">
                @* Разметка вкладки должна совпадать с _EditorTab.cshtml: подпись в .editor-tab-label
                   (она и обрезается многоточием), крестик — последний элемент кнопки. *@
                <div id="editor-tabs-list">
                    <button type="button" class="editor-tab-btn active" data-tab="tab-1" title="Запрос 1">
                        <span class="editor-tab-label">Запрос 1</span>
                        <span class="editor-tab-close" title="Закрыть вкладку" aria-hidden="true">&times;</span>
                    </button>
                </div>
                <button type="button" class="btn btn-ghost btn-sm btn-icon"
                        aria-label="Новая вкладка"
                        data-tip="Открыть ещё одну вкладку запроса"
                        hx-get="/editor?handler=Tab"
                        hx-vals='js:{index: window.wdvNextTabIndex ? window.wdvNextTabIndex() : 1}'
                        hx-target="#editor-panes"
                        hx-swap="beforeend">@UiIcons.Plus</button>
                <span class="htmx-indicator" role="status">
                    <span class="spinner" aria-hidden="true"></span>
                    <span class="visually-hidden">Открываем вкладку…</span>
                </span>
            </div>

            <div class="editor-toolbar">
                @* Кнопки иконочные: подпись живёт в aria-label (доступное имя) и
                   data-tip (видимая подсказка), горячая клавиша — в data-tip-keys. *@
                <button type="button" id="btn-run" class="btn btn-primary btn-icon" data-action="run"
                        aria-label="Выполнить запрос"
                        data-tip="Выполнить запрос под курсором"
                        data-tip-keys="Ctrl+Enter">@UiIcons.Play</button>
                <button type="button" id="btn-run-script" class="btn btn-icon" data-action="run-script"
                        aria-label="Выполнить скрипт"
                        data-tip="Выполнить все запросы во вкладке подряд"
                        data-tip-keys="Alt+X">@UiIcons.PlayScript</button>
                <button type="button" id="btn-cancel" class="btn btn-danger btn-icon" data-action="cancel" aria-disabled="true"
                        aria-label="Остановить выполнение"
                        data-tip="Прервать выполняющийся запрос">@UiIcons.Stop</button>

                <button type="button" id="btn-export-query" class="btn btn-icon" data-action="export-query"
                        aria-label="Экспорт результата в INSERT"
                        data-tip="Выгрузить результат запроса из вкладки в .sql-файл с INSERT-операторами">@UiIcons.Export</button>
                <button type="button" id="btn-import" class="btn btn-icon" data-action="open-import"
                        aria-label="Импорт SQL-файла"
                        data-tip="Загрузить .sql-файл: открыть в редакторе или выполнить на подключении">@UiIcons.Import</button>

                <span class="sep"></span>

                <label for="editor-ds" style="margin:0">DataSource</label>
                @* hx-sync: без него быстрая смена датасорса/базы подряд не сериализует запросы
                   к общей цели #editor-scope — поздний ответ раннего запроса может прийти
                   последним и затереть тулбар устаревшим фрагментом. *@
                <select id="editor-ds" name="ds" data-role="datasource-select"
                        hx-get="/editor?handler=Scope"
                        hx-trigger="change"
                        hx-target="#editor-scope"
                        hx-swap="innerHTML"
                        hx-sync="#editor-scope:replace">
                    @foreach (var ds in Model.DataSources)
                    {
                        @* data-kind — диалект для CodeMirror при переключении датасорса *@
                        <option value="@ds.Id" data-kind="@ds.Kind.ToString().ToLowerInvariant()">@ds.Name@(ds.IsProduction ? " ⚠" : "")</option>
                    }
                </select>

                @* База и схема грузятся вместе: смена датасорса или базы перерисовывает оба списка *@
                <span id="editor-scope" style="display:contents"
                      hx-get="/editor?handler=Scope"
                      hx-trigger="load"
                      hx-include="#editor-ds"
                      hx-swap="innerHTML">
                    <label for="editor-schema" style="margin:0">Схема</label>
                    <select id="editor-schema" name="schema" data-role="schema-select">
                        <option value="">— по умолчанию —</option>
                    </select>
                </span>

                <span class="sep"></span>

                @* Переключатель и индикатор — не кнопки: у них есть состояние,
                   которое подпись и обязана показывать. Текст остаётся. *@
                <label class="checkbox-field" data-tip="Подтверждать каждый запрос сразу, без явного COMMIT">
                    <input type="checkbox" id="editor-autocommit" data-role="autocommit" checked />
                    Auto-commit
                </label>
                <span class="tx-indicator" id="tx-indicator" data-role="tx-indicator" data-tip="Состояние транзакции в текущей сессии">
                    <span class="tx-dot"></span><span class="tx-text">нет транзакции</span>
                </span>
                @* Тот же размер, что у остальных иконок тулбара: в ряду одинаковых
                   пиктограмм разнокалиберность читается как небрежность, а не как иерархия. *@
                <button type="button" id="btn-commit" class="btn btn-icon" data-action="commit" aria-disabled="true"
                        aria-label="Зафиксировать транзакцию"
                        data-tip="COMMIT: сохранить изменения открытой транзакции">@UiIcons.Commit</button>
                <button type="button" id="btn-rollback" class="btn btn-icon" data-action="rollback" aria-disabled="true"
                        aria-label="Откатить транзакцию"
                        data-tip="ROLLBACK: отменить изменения открытой транзакции">@UiIcons.Rollback</button>
            </div>

            <div class="editor-tab-panes" id="editor-panes">
                <div class="editor-pane active" id="tab-1" data-tab-id="tab-1">
                    @* data-sql-editor — единственный признак SQL-редактора: по нему editor.js
                       поднимает CodeMirror 6. Другие атрибуты для этой цели не заводить. *@
                    <textarea class="sql-editor-source"
                              data-sql-editor
                              data-tab-id="tab-1"
                              data-ds-id="@(defaultDs?.Id.ToString() ?? "")"
                              data-dialect="@(defaultDs?.Kind.ToString().ToLowerInvariant() ?? "postgres")"
                              data-grid-target="#results-grid"
                              placeholder="-- Введите SQL-запрос…&#10;-- Ctrl+Enter — выполнить, Alt+X — выполнить скрипт"></textarea>
                </div>
            </div>
        </section>

        <div class="splitter-h" id="splitter-h" tabindex="0"
             aria-label="Изменить высоту панели результатов (перетащите или используйте стрелки; двойной клик — сброс)"></div>

        <section class="results-panel" id="results-panel">
            <div class="results-tabs">
                <button type="button" class="editor-tab-btn active" data-results-tab="grid">Результаты</button>
                <button type="button" class="editor-tab-btn" data-results-tab="messages">Сообщения</button>

                @* Правка строк результата. Доступна, только когда запрос — простой SELECT
                   из одной таблицы: grid.js сам включает и выключает эти кнопки.
                   Кнопки с подписью: доступное имя даёт видимый текст, поэтому
                   aria-label здесь не нужен — он бы только разошёлся с подписью. *@
                <div class="results-actions">
                    <button type="button" class="btn btn-ghost btn-sm" data-row-action="insert" aria-disabled="true"
                            data-tip="Вставить строку в таблицу результата">@UiIcons.RowAdd<span>Вставить</span></button>
                    <button type="button" class="btn btn-ghost btn-sm" data-row-action="update" aria-disabled="true"
                            data-tip="Изменить выделенную строку">@UiIcons.Pencil<span>Изменить</span></button>
                    <button type="button" class="btn btn-ghost btn-sm" data-row-action="delete" aria-disabled="true"
                            data-tip="Удалить выделенные строки из таблицы">@UiIcons.Trash<span>Удалить</span></button>
                    @* Подпись меняется вместе с состоянием — её переписывает splitter.js. *@
                    <button type="button" class="btn btn-ghost btn-sm" data-action="results-toggle"
                            aria-expanded="true" aria-controls="results-container"
                            data-tip="Свернуть или развернуть панель результатов">@UiIcons.ChevronDown<span data-toggle-label>Свернуть</span></button>
                </div>
            </div>
            <div class="results-body" id="results-container" data-role="results">
                @* data-result-grid — селектор, по которому grid.js создаёт виртуализованный грид
                   и подключается к SSE-стриму результатов *@
                <div id="results-grid" data-result-grid></div>
            </div>
            
        </section>
    </div>
</div>

@* Импорт живёт в нативном <dialog>: фокус-ловушка, Esc и подложка — без своего кода,
   как и у формы подключения. *@
<dialog id="import-dialog" class="modal" aria-labelledby="import-dialog-title">
    @* Режим «в редактор» отправляется через htmx: после swap editor.js ловит htmx:afterSwap
       и поднимает CodeMirror на новой вкладке. Ручная вставка HTML этого не даёт. *@
    <form id="import-form" class="modal-form"
          hx-post="/editor?handler=ImportTab"
          hx-encoding="multipart/form-data"
          hx-target="#editor-panes"
          hx-swap="beforeend"
          hx-trigger="wdv:import-editor"
          hx-vals='js:{index: window.wdvNextTabIndex ? window.wdvNextTabIndex() : 1, ds: document.getElementById("editor-ds").value}'>
        @Html.AntiForgeryToken()
        <header class="modal-header">
            <h2 class="modal-title" id="import-dialog-title">Импорт SQL-файла</h2>
        </header>

        <div class="modal-body">
            <label for="import-file">Файл .sql</label>
            <input type="file" id="import-file" name="file" accept=".sql,text/plain" required />

            <fieldset style="border:0;padding:0;margin:var(--space-md) 0 0">
                <legend>Что сделать с файлом</legend>
                @* По умолчанию — открыть в редакторе: пользователь видит, что именно
                   выполняет, прежде чем это выполнится на боевой базе. *@
                <label class="checkbox-field">
                    <input type="radio" name="mode" value="editor" checked />
                    Открыть в редакторе, не выполняя
                </label>
                <label class="checkbox-field">
                    <input type="radio" name="mode" value="transaction" />
                    Выполнить целиком в одной транзакции (ошибка — полный откат)
                </label>
                <label class="checkbox-field">
                    <input type="radio" name="mode" value="continue" />
                    Выполнить по одному оператору, продолжая после ошибок
                </label>
            </fieldset>

            <div id="import-result" aria-live="polite"></div>
        </div>

        <footer class="modal-footer">
            <span class="footer-spacer"></span>
            <button type="button" class="btn btn-ghost btn-icon" data-action="close-dialog"
                    aria-label="Отмена"
                    data-tip="Закрыть окно, ничего не импортируя">@UiIcons.Close</button>
            <button type="button" id="btn-import-run" class="btn btn-primary btn-icon"
                    aria-label="Импортировать"
                    data-tip="Загрузить файл выбранным способом">@UiIcons.Import</button>
        </footer>
    </form>
</dialog>

@section Scripts {
    <script>
        // Номер новой вкладки: максимальный существующий + 1. По количеству вкладок
        // считать нельзя — после закрытия номера переиспользуются, и новая панель
        // получает id уже открытой (две вкладки с одним data-tab, обе «активные»).
        window.wdvNextTabIndex = function () {
            var max = 0;
            document.querySelectorAll("#editor-panes .editor-pane, #editor-tabs-list .editor-tab-btn").forEach(function (el) {
                var n = parseInt(String(el.id || el.dataset.tab || "").replace("tab-", ""), 10);
                if (n > max) max = n;
            });
            return max + 1;
        };

        // Импорт .sql: открыть файл вкладкой редактора либо выполнить на подключении.
        (function () {
            var dialog = document.getElementById("import-dialog");
            var form = document.getElementById("import-form");
            if (!dialog || !form) return;

            var fileInput = document.getElementById("import-file");
            var result = document.getElementById("import-result");
            var runButton = document.getElementById("btn-import-run");

            function report(text, isError) {
                result.textContent = text;
                result.className = isError ? "form-error" : "";
            }

            function token() {
                var input = form.querySelector('input[name="__RequestVerificationToken"]');
                return input ? input.value : "";
            }

            function selectedDatabase() {
                // Список баз рисуется обработчиком Scope и может отсутствовать (Oracle).
                var select = document.querySelector('#editor-scope select[name="db"]');
                return select ? select.value : "";
            }

            document.addEventListener("click", function (e) {
                if (e.target.closest('[data-action="open-import"]')) {
                    report("", false);
                    dialog.showModal();
                    return;
                }
                if (dialog.open && e.target.closest('[data-action="close-dialog"]')) {
                    dialog.close();
                }
            });

            runButton.addEventListener("click", async function () {
                var file = fileInput.files[0];
                if (!file) {
                    report("Выберите .sql-файл.", true);
                    return;
                }

                var mode = form.querySelector('input[name="mode"]:checked').value;
                if (mode === "editor") {
                    htmx.trigger(form, "wdv:import-editor");
                    dialog.close();
                    return;
                }

                var body = new FormData();
                body.append("file", file);
                body.append("ds", document.getElementById("editor-ds").value);
                body.append("db", selectedDatabase());
                body.append("mode", mode);

                report("Выполняется…", false);
                runButton.setAttribute("aria-disabled", "true");
                try {
                    var response = await fetch("/api/import/sql", {
                        method: "POST",
                        body: body,
                        headers: { "RequestVerificationToken": token() }
                    });
                    var data = await response.json();

                    if (!response.ok) {
                        report(data.error || ("Импорт не выполнен (HTTP " + response.status + ")."), true);
                        return;
                    }

                    var summary = "Операторов: " + data.statements
                        + "; выполнено: " + data.executed
                        + "; строк затронуто: " + data.rowsAffected
                        + "; за " + data.elapsedMs + " мс.";
                    if (data.errors && data.errors.length) {
                        summary += " Ошибок: " + data.errors.length
                            + ". Первая — оператор №" + data.errors[0].index + ": " + data.errors[0].message;
                    }
                    report(summary, !!(data.errors && data.errors.length));
                } catch (err) {
                    report("Импорт не выполнен: " + err.message, true);
                } finally {
                    runButton.removeAttribute("aria-disabled");
                }
            });
        })();

        // Экспорт результата запроса из активной вкладки в .sql с INSERT-операторами.
        (function () {
            var button = document.getElementById("btn-export-query");
            if (!button) return;

            button.addEventListener("click", async function () {
                // CodeMirror держит текст у себя — syncAll переносит его в textarea.
                if (window.WebDbEditor && window.WebDbEditor.syncAll) window.WebDbEditor.syncAll();

                var pane = document.querySelector(".editor-pane.active");
                var textarea = (pane && pane.querySelector("textarea[data-sql-editor]"))
                    || document.querySelector("textarea[data-sql-editor]");
                var sql = textarea ? textarea.value.trim() : "";

                var status = document.getElementById("results-status");
                if (!sql) {
                    if (status) status.textContent = "Экспорт: во вкладке нет запроса.";
                    return;
                }

                // ponytail: имя приёмника спрашиваем нативным prompt — отдельная модалка
                // ради одного поля не окупается.
                var target = window.prompt(
                    "Имя таблицы-приёмника для INSERT-операторов (можно «схема.таблица»):", "");
                if (!target) return;

                var db = document.querySelector('#editor-scope select[name="db"]');
                if (status) status.textContent = "Экспорт результата…";

                try {
                    var response = await fetch("/api/export/sql/query", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            ds: document.getElementById("editor-ds").value,
                            sql: sql,
                            target: target,
                            db: db ? db.value : null
                        })
                    });

                    if (!response.ok) {
                        var error = await response.json().catch(function () { return {}; });
                        if (status) status.textContent = "Экспорт не выполнен: " + (error.error || response.status);
                        return;
                    }

                    var blob = await response.blob();
                    var url = URL.createObjectURL(blob);
                    var link = document.createElement("a");
                    link.href = url;
                    link.download = target.replace(/"/g, "") + ".sql";
                    link.click();
                    URL.revokeObjectURL(url);
                    if (status) status.textContent = "Экспорт выполнен: " + link.download;
                } catch (err) {
                    if (status) status.textContent = "Экспорт не выполнен: " + err.message;
                }
            });
        })();

        // Переключение вкладок редактора (делегирование на панели вкладок)
        (function () {
            var tabsList = document.getElementById("editor-tabs-list");
            var panes = document.getElementById("editor-panes");

            function activate(tabId) {
                tabsList.querySelectorAll(".editor-tab-btn").forEach(function (b) {
                    var isActive = b.dataset.tab === tabId;
                    b.classList.toggle("active", isActive);
                    // Полоса прокрутки списка скрыта, поэтому активную вкладку
                    // подтягиваем в видимую область сами.
                    if (isActive) b.scrollIntoView({ inline: "nearest", block: "nearest" });
                });
                panes.querySelectorAll(".editor-pane").forEach(function (p) {
                    p.classList.toggle("active", p.id === tabId);
                });
                document.dispatchEvent(new CustomEvent("wdv:tab-activated", { detail: { tabId: tabId } }));
                syncRunButtons();
            }

            // На вкладке с данными редактора нет, и активной остаётся textarea другой
            // вкладки: нажатие «Выполнить» отправило бы в базу невидимый запрос.
            // aria-disabled уважает обработчик кнопок в editor.js.
            function syncRunButtons() {
                var pane = panes.querySelector(".editor-pane.active");
                var noSql = !!pane && !pane.querySelector("textarea[data-sql-editor]");
                document.querySelectorAll('[data-action="run"], [data-action="run-script"]').forEach(function (b) {
                    b.setAttribute("aria-disabled", String(noSql));
                });
            }

            // Полоса прокрутки списка скрыта (иначе панель прыгает по высоте),
            // а вертикальное колесо горизонтальный контейнер не прокручивает —
            // переводим его в горизонтальную прокрутку сами.
            tabsList.addEventListener("wheel", function (e) {
                if (e.deltaY === 0 || tabsList.scrollWidth <= tabsList.clientWidth) return;
                tabsList.scrollLeft += e.deltaY;
                e.preventDefault();
            }, { passive: false });

            tabsList.addEventListener("click", function (e) {
                var btn = e.target.closest(".editor-tab-btn");
                if (!btn) return;
                if (e.target.classList.contains("editor-tab-close")) {
                    // Закрытие вкладки. Последнюю не закрываем: редактор без единой вкладки
                    // оставляет страницу пустой, а создать новую можно только кнопкой «+».
                    if (tabsList.querySelectorAll(".editor-tab-btn").length < 2) return;
                    var tabId = btn.dataset.tab;
                    var wasActive = btn.classList.contains("active");
                    // Соседняя вкладка справа, иначе слева — закрытие не должно
                    // перебрасывать пользователя в начало списка.
                    var neighbour = btn.nextElementSibling || btn.previousElementSibling;
                    var pane = document.getElementById(tabId);
                    if (pane) pane.remove();
                    btn.remove();
                    if (wasActive && neighbour) activate(neighbour.dataset.tab);
                    return;
                }
                activate(btn.dataset.tab);
            });

            // После добавления новой вкладки через HTMX — активируем её
            document.body.addEventListener("htmx:afterSwap", function (e) {
                if (e.detail.target && e.detail.target.id === "editor-panes") {
                    var last = panes.querySelector(".editor-pane:last-child");
                    if (last) activate(last.id);
                }
            });

            // Переключение вкладок панели результатов
            document.querySelector(".results-tabs").addEventListener("click", function (e) {
                var btn = e.target.closest("[data-results-tab]");
                if (!btn) return;
                document.querySelectorAll(".results-tabs .editor-tab-btn").forEach(function (b) {
                    b.classList.toggle("active", b === btn);
                });
                document.dispatchEvent(new CustomEvent("wdv:results-tab", { detail: { tab: btn.dataset.resultsTab } }));
            });
        })();
    </script>
}
