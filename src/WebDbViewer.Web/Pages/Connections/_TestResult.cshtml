@model WebDbViewer.Web.Pages.Connections.TestResultVm
@if (Model.Success)
{
    <div class="alert alert-success">
        &#10003; Подключение успешно. Версия сервера: @Model.Message
    </div>
}
else
{
    <div class="alert alert-error">
        &#10007; Не удалось подключиться: @Model.Message
    </div>
}
