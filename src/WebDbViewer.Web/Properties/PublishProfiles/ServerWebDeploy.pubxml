<?xml version="1.0" encoding="utf-8"?>
<!--
  Web Deploy (MSDeploy) profile for the production IIS server via the Remote Agent Service (MsDepSvc, port 80).
  Usage (CLI): dotnet publish WebHook.Management.csproj -c Release -p:PublishProfile=ServerWebDeploy -p:Password=<pwd> -p:AllowUntrustedCertificate=True
  Or one-click "Publish" from Visual Studio (it will prompt for the password).
  EnableMSDeployAppOffline drops app_offline.htm during sync so the in-process WebHook.Management.dll is unlocked.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://db.pasport-viza.uz/</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>2d54a14a-0f67-6293-d00a-71ad2f765d7a</ProjectGuid>
    <MSDeployServiceURL>http://192.168.1.93/MsDeployAgentService</MSDeployServiceURL>
    <DeployIisAppPath>db.pasport-viza.uz</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <MSDeployPublishMethod>RemoteAgent</MSDeployPublishMethod>
    <SkipExtraFilesOnServer>false</SkipExtraFilesOnServer>
    <EnableMSDeployAppOffline>true</EnableMSDeployAppOffline>
    <EnableMSDeployBackup>false</EnableMSDeployBackup>
    <AuthType>NTLM</AuthType>
    <UserName>Administrator</UserName>
    <_SavePWD>true</_SavePWD>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <!--
    wwwroot is deployed separately (frontend build), so it is absent from the publish package.
    With SkipExtraFilesOnServer=false MSDeploy would delete it on the server — this rule excludes
    the destination wwwroot directory (and its subtree) from the sync.
    Mirrors the built-in SkipAppDataOnDeploy rule: empty SkipAction + Apply, since the remote agent
    rejects the "skipAction" directive.
  -->
  <ItemGroup>
    <MsDeploySkipRules Include="SkipWwwrootOnDeploy">
      <SkipAction></SkipAction>
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>\\wwwroot$</AbsolutePath>
      <Apply>Destination</Apply>
      <XPath></XPath>
    </MsDeploySkipRules>
  </ItemGroup>
</Project>
